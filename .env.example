# Copy to .env.local and fill in. Never commit .env.local.
# Your dashboard password (min 8 characters). Log in at /admin
ADMIN_PASSWORD=
# Optional: random string used to sign login cookies (otherwise derived from the password)
SESSION_SECRET=
# Production on Vercel: create a Blob store and Vercel adds this automatically
BLOB_READ_WRITE_TOKEN=

# Paystack, for the shop. Server only: never prefix with NEXT_PUBLIC_.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
